<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#101318">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DroidInspect"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="APK and .NET file inspection"
        android:textColor="#AEB8C6"
        android:textSize="14sp" />

    <Button
        android:id="@+id/openButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Select APK / DLL / EXE" />

    <Button
        android:id="@+id/diagnosticsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Run Phase 1 Diagnostics" />

    <Button\n        android:id="@+id/browseDexButton"\n        android:layout_width="match_parent"\n        android:layout_height="wrap_content"\n        android:text="Browse DEX Classes / Methods"\n        android:enabled="false" />\n\n    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ready"
        android:textColor="#80CBC4"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:background="#191F27"
        android:padding="12dp">

        <TextView
            android:id="@+id/reportView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E5EAF0"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="3dp" />
    </ScrollView>

</LinearLayout>
