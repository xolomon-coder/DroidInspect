<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#101318">

    <TextView
        android:id="@+id/sourceEditorTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="C# Source Project"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:id="@+id/sourceEditorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="Source workspace"
        android:textColor="#80CBC4"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/sourceEditorFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/sourceEditorSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SAVE" />

        <Button
            android:id="@+id/sourceEditorAdd"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NEW FILE" />

        <Button
            android:id="@+id/sourceEditorImport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="IMPORT" />
    </LinearLayout>

    <Button
        android:id="@+id/sourceEditorExport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EXPORT SOURCE PROJECT ZIP" />

    <Button
        android:id="@+id/sourceEditorCompile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COMPILE OFFLINE TO NEW DLL" />

    <Button
        android:id="@+id/sourceEditorExportDll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="EXPORT REBUILT DLL" />

    <Button
        android:id="@+id/sourceEditorExportReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="EXPORT DLL COMPATIBILITY REPORT" />

    <EditText
        android:id="@+id/sourceEditorText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:fontFamily="monospace"
        android:inputType="textMultiLine|textNoSuggestions"
        android:singleLine="false"
        android:textColor="#E5EAF0"
        android:textSize="12sp"
        android:background="#191F27"
        android:padding="10dp"
        android:hint="C# source"
        android:textColorHint="#9AA6B2" />
</LinearLayout>
