<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sourceEditorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="#101318">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/sourceEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="C# Source Project"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/sourceEditorOverflow"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⋮"
            android:textSize="24sp"
            android:contentDescription="More editor actions" />
    </LinearLayout>

    <TextView
        android:id="@+id/sourceEditorStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:text="Source workspace"
        android:textColor="#80CBC4"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <Spinner
        android:id="@+id/sourceEditorFiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/sourceEditorSearchPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:background="#202833">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/sourceEditorSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="textNoSuggestions"
                android:hint="Find in complete source"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA6B2" />

            <Button
                android:id="@+id/sourceEditorSearchRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="GO" />

            <Button
                android:id="@+id/sourceEditorSearchClose"
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="×"
                android:textSize="20sp"
                android:contentDescription="Close search panel" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sourceEditorSearchInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:text="Find in complete source"
                android:textColor="#80CBC4"
                android:textSize="11sp"
                android:maxLines="2" />

            <Button
                android:id="@+id/sourceEditorSearchPrevious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="PREV" />

            <Button
                android:id="@+id/sourceEditorSearchNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="NEXT" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="#191F27">

        <TextView
            android:id="@+id/sourceEditorLineNumbers"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:gravity="top|end"
            android:fontFamily="monospace"
            android:textColor="#718096"
            android:textSize="12sp"
            android:background="#151A20"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingEnd="5dp"
            android:text="1" />

        <EditText
            android:id="@+id/sourceEditorText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="top|start"
            android:fontFamily="monospace"
            android:inputType="textMultiLine|textNoSuggestions"
            android:singleLine="false"
            android:textColor="#E5EAF0"
            android:textSize="12sp"
            android:background="#191F27"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:imeOptions="flagNoExtractUi"
            android:hint="C# source"
            android:textColorHint="#9AA6B2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <Button
            android:id="@+id/sourceEditorPreviousPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="‹ PREVIOUS PAGE" />

        <TextView
            android:id="@+id/sourceEditorPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="#80CBC4"
            android:textSize="11sp"
            android:visibility="gone"
            android:text="Page 1 / 1" />

        <Button
            android:id="@+id/sourceEditorNextPage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"
            android:text="NEXT PAGE ›" />
    </LinearLayout>

    <!-- Hidden action controls retain the existing tested action handlers; the overflow menu invokes them. -->
    <LinearLayout
        android:id="@+id/sourceEditorLegacyActions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <LinearLayout android:id="@+id/sourceEditorProjectActionsRow" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/sourceEditorOutputActionsRow" android:layout_width="0dp" android:layout_height="0dp" />
        <Button android:id="@+id/sourceEditorSave" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorAdd" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorImport" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorExport" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorCompile" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorExportDll" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorExportReport" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorFind" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <Button android:id="@+id/sourceEditorReplace" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
