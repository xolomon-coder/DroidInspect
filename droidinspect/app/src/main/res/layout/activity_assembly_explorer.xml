<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#101318">

    <TextView
        android:id="@+id/assemblyExplorerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assembly Explorer"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="2" />

    <TextView
        android:id="@+id/assemblyExplorerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="Indexing managed assembly…"
        android:textColor="#80CBC4"
        android:textSize="12sp"
        android:maxLines="3" />

    <EditText
        android:id="@+id/assemblyExplorerSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:hint="Search types, members, references or tokens"
        android:inputType="text"
        android:textColor="#FFFFFF"
        android:textColorHint="#9AA6B2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/assemblyExplorerCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/assemblyExplorerSort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/assemblyExplorerBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BACK TO TREE"
            android:enabled="false" />

        <Button
            android:id="@+id/assemblyExplorerGoToken"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GO TO TOKEN" />
    </LinearLayout>

    <ListView
        android:id="@+id/assemblyExplorerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#39424E"
        android:dividerHeight="1dp"
        android:background="#191F27" />
</LinearLayout>
